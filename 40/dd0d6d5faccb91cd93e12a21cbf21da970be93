template_create.py", "packages/evals/tests/test_writer_view_rollups.py", "packages/evals/tests/toyhost_cells.py", "packages/evals/tests/toyhost_memo.py", "packages/evals/tests/writer_case_support.py", "packages/evals/tests/writer_eval_support.py", "packages/evals/tests/writer_host_support.py", "packages/evals/tests/writer_pairwise_support.py", "packages/evals/tests/writer_promotion_support.py", "packages/registry/tests/unit/registry/test_unsigned_agent_concession_expires.py", "pyproject.toml", "scripts/test.sh", "tests/clock_isolation.py", "tests/enforcement/_function_level_import_exemptions.txt", "tests/enforcement/_model_literal_exemptions.txt", "tests/enforcement/_public_api_consumers.txt", "tests/enforcement/test_a_tool_states_its_notes_first.py", "tests/enforcement/test_clock_isolation.py", "tests/enforcement/test_evals_cites_no_gitignored_plan.py", "tests/enforcement/test_public_api_has_a_caller.py"], "files_oracle": [".prawduct/artifacts/build-plan-skills-under-test.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "A campaign's stored floor reason still carries a measure's reader name, so renaming a host pass/fail measure a floor reads moves the campaign fingerprint, against the shape-66 rule that names are never evidence", "recommendation": "Scope: class. Why it broke: shape 66 moved BarStatus to a decision that is worded at render (BarStatus.reason(measure)) and dropped MeasureReading.name, but floors still go through the old path. campaign_readings reads each row's floors with floor_readings(bundle, control, arm) and no check_names (campaign_readings.py:757 and :1060), then evaluate_floor stores verdict.reason.stored() into FloorStatus.reason (report/decision.py:408). floor_readings names a goal check by its expression in that case, but it names every other rule-rate measure (a pass/fail scorer, a lower-is-better boolean) as measure_name(name, descriptor.reader_name) (decision.py:775-782). Most of the floor sentences quote that name: _counts 'passed {rate.name} on', _rate_verdict \"{candidate}'s drop on {rate.name}\", '{rate.name} cannot separate the arms', 'no interval was computed on {rate.name}' (decision.py:448, 482, 511, 515). CampaignReadings.floors is in the campaign bundle's evidence (_evidence_of drops only 'aggregate'). So a floor that reads every pass rate, or one on a single host rate, freezes the host's reader name into the campaign fingerprint. Renaming that measure then stales the analysis. CHANGELOG and the evidence_digest docstring both say that never happens. The rename test (test_name_free_fingerprints.py:386, measure field_accuracy) has no floor, so this path is untested. The remedy needs one owner: on the readings path, name a non-check rate by its key, as a check is already named by its expression. Then either word the floor reason at render, as BarStatus.reason(measure) does, or carry the measure key in the Said and name it in PageForms. Add a rename test whose campaign declares a floor over a host pass/fail measure that has a reader_name, and assert the campaign fingerprint does not move. Search for other Said sentences that reach .stored() through RateReading.name.", "files": ["packages/evals/src/threetears/evals/analysis/report/decision.py", "packages/evals/src/threetears/evals/analysis/campaign_readings.py"], "fid": "R-1"}, {"goal": "Nothing Is Broken", "severity": "warning", "title": "Test evidence is stale: the only recorded run is from 2026-11-08T16:23Z (27,305 passed, 1 failed, 13 skipped), before every merge in the newest delta, and its one failure is not named", "recommendation": "Scope: instance. `prawduct-hook test-status` exits 1 with 'stale: 1 test(s) failing in saved evidence'. The evidence (`--from-counts passed=27305 failed=1 skipped=13`, timestamp 2026-11-08T16:23:31Z) comes before 3ed12a311..40dd0d6d5. That range covers lease shutdown, recorded-completion replay, judge examples, durable v17 and bundle shape 66, so nothing on record shows the suite at this head. Run the suite at the head. Record its evidence. Name each failure, and confirm that every red is one of the goldens or pins being regenerated on the other branch, as the brief expects, and not production behaviour.", "files": [".prawduct/.test-evidence.json"], "fid": "R-2"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "A derived arm's printed name is rebuilt by parsing its frozen label string back into levers, at a third parse site that must agree with two other derivations", "recommendation": "Scope: class. Why it broke: the label is frozen as text, so the structure it was spelled from has to be parsed back out of it. campaigns.campaign_arms freezes a derived label as text ('chunk tokens 1024tok, retriever top k 3', via style.arm_name over arm_names([named + derived])). words._named_spelling (new in d72c7e4bc) then rebuilds the printed name by stripping _TELL_APART, splitting on ', ' and prefix-matching each part against lever_reader_name(lever), which is humanize plus HUMANIZE_OVERRIDES. It takes the lever tuple from a second arm_names call over a different population: the aspects' variant_index entries, whose level displays _declared_level_names has already renamed. words.reader_arm_name parses the same string a third time. The renaming only works if all three agree: the split format, the humanize spelling at freeze and at render, and the distinguishing-lever set of the two arm_names populations. When they disagree (a level display that contains ', ', an override added to HUMANIZE_OVERRIDES after freezing, or the two populations differing on which levers distinguish), _named_spelling silently returns the id-words label, and every page prints 'chunk tokens ...' with no error and no test signal. Construction: freeze the structure the label was spelled from, i.e. the ordered lever ids of each derived arm plus its tell-apart suffix (CampaignArm already carries `levers`). Render the printed name from that through one function, and delete the prefix-matching in _named_spelling. To bound the class, search words.py and style.py for `_TELL_APART` and `split(\", \")`.", "files": ["packages/evals/src/threetears/evals/analysis/report/words.py", "packages/evals/src/threetears/evals/analysis/campaigns.py", "packages/evals/src/threetears/evals/analysis/style.py"], "fid": "R-3"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "Read-as-earlier-version paths that shape 66 made unreachable are kept and extended: v1/legacy fingerprint branches, campaign shape 2 read as 3, and readings that changed shape under an unmoved CAMPAIGN_BUNDLE_SHAPE", "recommendation": "Scope: instance. Why it broke: the shape-66 cut refuses every bundle frozen before it, but the compatibility paths for older fingerprints and frames were extended instead of removed. Any re-assembled bundle now carries schema_version 66 in its pre-image, so a fingerprint taken in an earlier version can never match it (inspect reports package_shape whatever is computed). Even so, this change added new legacy-version plumbing: `levels=False` on unnamed_axes and _evidence_of, the `unnamed` gate in evidence_digest (now also covering case_label), and the levels-retaining v2/v1 branch in campaign_bundle._campaign_digest. That is version-compatibility machinery with nothing left to stay compatible with: every reachable comparison has the same outcome without it. The campaign side is the same. _EARLIER_SHAPES={2} and _as_this_shape still claim to read a shape-2 frame 'as this one', but a shape-2 frame can only sit over pre-66 aspects, so it is never reached. If it were reached, it would now fail CampaignReadings validation (BarStatus.decision is required and MeasureReading.name is gone) rather than be refused with a remedy. And the readings changed shape in 6548a55b0 while CAMPAIGN_BUNDLE_SHAPE stayed 3, so a shape-3 frame written yesterday and one written today carry the same number with incompatible readings. Only the ordering of the aspect refusal in analysis_campaign_bundle/from_dict keeps that from surfacing. Every stored analysis is regenerated once anyway, so this is the free moment to fix it: delete the v1 fingerprint branch and the legacy `like` handling in evidence_digest/_campaign_digest/unnamed_axes, delete _EARLIER_SHAPES/_as_this_shape/_EVIDENCE_SHAPE, and move CAMPAIGN_BUNDLE_SHAPE so that the shape number identifies the readings it holds.", "files": ["packages/evals/src/threetears/evals/analysis/bundle/schema.py", "packages/evals/src/threetears/evals/analysis/campaign_bundle.py"], "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "JobLeases' shutdown lifecycle is several flags that hold() resets unconditionally, so a lease held during a shutdown clears the shutdown's deadline and ends with _down set over a live lease", "recommendation": "Scope: instance. Why it broke: the shutdown lifecycle added in cb3d85b43 is spread across several flags with no single model of which state the leases are in. The conditions observed: `_shutting` (None or _ShuttingDown) is set at the start of shut_down and never cleared by it. `_down` (bool) is set after the expiry wait. `_renewer` (task or None) is cancelled and nulled. `_executor` is closed by _close_pool and lazily recreated by _pool(). `_held` is snapshotted and emptied. hold() resets `_shutting=None, _down=False` and restarts the renewer whenever it is called, and EvalJobManager refuses nothing once shutdown has begun (the run_task path at jobs.py:818 and the group launch at jobs.py:1032 both call hold()). So a hold() that lands while shut_down awaits its writes has three effects. (1) It clears `_shutting`, so an expiry already running loses its deadline bound and writes settle_job_record instead of the shutdown's loss. (2) shut_down then sets `_down=True` and closes the pool over a lease that is still held and a renewer that is still live; that renewer re-creates the pool after shutdown has returned. (3) That lease's expiry refuses every write under `_down`. The transitions span hold(), shut_down(), _expiry_write(), _write_why_and_loss() and _renew_while_held(). Model the lifecycle once (open / shutting(cause, deadline) / down) on a single field, have hold() refuse or defer while shutting or down rather than silently reopening, and have the manager refuse new held work once shutdown begins.", "files": ["packages/evals/src/threetears/evals/kernel/job_leases.py", "packages/evals/src/threetears/evals/run/jobs.py"], "fid": "R-5"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "TrialCheck.name and TrialJudgement.dim mean an id in a bundle and a printed name on a page's trial block: one type, two meanings, chosen by which layer holds it", "recommendation": "Scope: instance. Why it broke: 6548a55b0 moved the bundle's trial fields to ids, but the page's trial block kept reusing the bundle models and overwrote the same fields with printed names (build._trial_blocks uses model_copy(update={'name': ...}) and {'dim': trial_dimension(...)}), as the field descriptions now admit ('in a bundle, its measure's key; on a page's trial block, the name the page prints'). Consumers rely on the id meaning: warnings._undecided_bound compares `failure.name == check.name`, report_input_build._reason calls `aspect.catalog_name(check.name)`, and _trial_why keys check_failures by name. catalog_name returns its input on a miss, so handing any of these a page block's check quietly matches nothing or prints the already-printed name, with no type to catch it. Give the page block its own type, or a separate printed field, so the bundle field only ever holds the id.", "files": ["packages/evals/src/threetears/evals/analysis/bundle/schema.py", "packages/evals/src/threetears/evals/analysis/report/build.py", "packages/evals/src/threetears/evals/analysis/report/campaign/warnings.py", "packages/evals/src/threetears/evals/analysis/report_input_build.py"], "fid": "R-6"}, {"goal": "Everything Is Coherent", "severity": "note", "title": "Two rules read a lever id as words, and the v16 step's docstring and MIGRATIONS note call theirs 'the one place a lever's name is derived'", "recommendation": "Scope: instance. Why it broke: derived arm labels began to be spelled from ids. _migrated_lever_name (a `[_.]+` regex less the callable prefix) and style.lever_reader_name/humanize('dimension', ...) (the same regex plus HUMANIZE_OVERRIDES and an expression guard, keeping the callable prefix) are two derivations of a lever's name from its id. Since d72c7e4bc the second also spells every frozen derived arm label, so the 'one place' claim in campaign_upgrade._migrated_lever_name and in MIGRATIONS.toml is false. Nothing reads the claim. Delete it, or route the migration through humanize so a single rule remains.", "files": ["packages/evals/src/threetears/evals/schema/campaign_upgrade.py", "packages/evals/src/threetears/evals/analysis/style.py"], "fid": "R-7"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "Durable v17 is a major taken for an optional field, and the v16 step it exists to run pins every pre-v17 campaign's lever names to its ids read as words, outranking the host's declared reader names. Neither the major nor that downstream effect has a recorded why", "recommendation": "Scope: instance. versioning.py's own rule says an optional field with a default is a minor ('A minor is additive ... a new optional field with a default'). SweptAxis.reader_name is optional (default None, exclude_if None), and nothing on read requires it. The major exists only to run upgrade_campaign_v16, and that step has an effect nobody recorded. It writes _migrated_lever_name(axis_id) onto every stored declared axis, and lever_names_of / name_declared_axes then treat that stored name as authored: a stored name wins over SweptAxis's host declaration, and campaign_update keeps an axis that already has a name. So every campaign stored before v17 (Discodon's prod campaigns included) names each declared lever 'chunk tokens' for good, even after the host declares reader_name='Chunk size'. The owner ruling exists to bring in exactly those declared names, and nothing re-derives them except an explicit rename through campaign_update. The CHANGELOG 'Durable v17 (a major)' paragraph, the MIGRATIONS.toml entry (line 184), the v17 ledger line in versioning.py and commit 79b5c9688 all state what the major costs (no rollback; older pods refuse during a rolling deploy) but not why a minor would not do. None of them tells hosts that migrated campaigns shadow their new declarations. Decide one of two ways. Ship it as v16.10 with no step: unnamed stored axes fall back at render to the host's name, else the id read as words, which lever_names_of already does for levers no axis names. Or keep the major and write in the v17 ledger line and MIGRATIONS why the id-as-words name must be stored and outrank the host's, and give the host the step it takes to adopt its own names on existing campaigns.", "files": ["packages/evals/src/threetears/evals/schema/campaign_upgrade.py", "packages/evals/src/threetears/evals/schema/versioning.py", "packages/evals/src/threetears/evals/kernel/declaration.py", "packages/evals/MIGRATIONS.toml", "CHANGELOG.md"], "fid": "R-8"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Mid-build decisions in the newest delta (3ed12a311..40dd0d6d5), for the owner. The manifest names no plan (scope null), so none is judged against a plan's Goals", "recommendation": "Scope: none. Settled by the owner (2026-11-11 rulings, cited in CHANGELOG and MIGRATIONS): names are presentation, never evidence (bundle shape 66, covering levers, measures, levels and case labels); every lever declares a stored reader name. Builder's own choices, recorded only in CHANGELOG, docstrings and commits: (a) durable v17 as a major with an id-as-words step (see the warning above); (b) shape 66 reads no earlier shape as stored, so every stored analysis, report snapshot freeze and writer-case mint over a shape-65 bundle is refused until it is regenerated, with no migration and no auto-regeneration; (c) recording format 3 with the renamed-cell binding rule: a cell named nowhere stands for the one recorded line that shares its subject, arm or case; ambiguity is refused, and an arm added beside one sharing every prompt is told apart from a rename only by ask order; (d) a shutdown gives the held jobs' loss writes half its bound and the expiries already running the rest; (e) one lever-naming rule per campaign (the first declared axis in aspect order wins), and a campaign bundle whose aspects disagree is refused; (f) a judge's examples are graded under the eval's cost cap: the crossing call lands whole, and unpriced spend from the arms or the examples stops the grading; (g) a multi-arm quick-path Eval with no name and no cases file is refused. Nothing here needs an edit; the list is for the owner's ruling.", "files": ["CHANGELOG.md", "packages/evals/MIGRATIONS.toml"], "fid": "R-9"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "style._check_subject is an unbounded functools.cache keyed by host-declared goal-check expressions, in code a long-lived host process runs on every page render", "recommendation": "Scope: instance. packages/evals/src/threetears/evals/analysis/style.py:327 wraps _check_subject(expression: str) in @functools.cache, so every distinct goal-check expression any campaign has ever rendered stays in memory for the life of the process (a host such as Discodon serving many templates). The set grows only as hosts author checks, so the growth is slow, but nothing bounds or clears it. The other caches this bundle added are bounded (lru_cache with maxsize _MEMO, _CACHED_INPUTS or 4096). Bound this one the same way.", "files": ["packages/evals/src/threetears/evals/analysis/style.py"], "fid": "R-10"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Learnings Cross-Check: an empty read list, since this repo carries no .claude/rules/learnings/", "recommendation": "Scope: none. `prawduct-hook learnings-files --for-diff` printed nothing and exited 0. /opt/3tears/.claude/wt/evals-reset/.claude/rules/ does not exist, so no learnings rule was in the session's context, and none could be checked for a regression or cited. This is a fact about the corpus, not a defect in the diff. The cross-check produced no answer, which is not the same as a clean one.", "fid": "R-11"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Backlog Reconciliation produced no answer: the backlog cache for pacepace/3tears is confirmed but holds 0 items, and the issues this branch cites (#1141, #1142, #1134) resolve to nothing in it", "recommendation": "Scope: none. `backlog cache-query open --repo pacepace/3tears` returned '0 item(s)' (cache confirmed 2026-11-11T15:15Z, exit 0, not exit 6). `unstaged` and `by-area --all` were empty too. `resolve` returned 'unresolved \u2014 no item in the cache claims that id' for 1141 (where prior findings R-3/R-4 were filed), for 1142 (the kit's upstream asks) and for 1134. The issues exist, so the cache is not tracking them. No resolved item, hygiene signal or dangling id could be judged. Run `prawduct-hook backlog sync --repo pacepace/3tears` and reconcile again before the develop merge.", "fid": "R-12"}], "counts": {"blocking": 0, "warning": 7, "note": 5}, "observations": [], "duration_seconds": 1500, "scope": null, "scope_chosen_by": "none", "scope_unresolved_cause": "no-claim", "scope_reason": "no live plan claims `evals/reset`", "base_extended_from": null, "chunks": [], "chunks_proposed": [], "chunk": null, "base_reviewed": "1cbc805d868b7f6838b952991f0f99d3a02bd516", "record_lint": {"records": [".prawduct/artifacts/build-plan-skills-under-test.md", "CHANGELOG.md", "README.md", "docs/eval-report-kit/ANALYST.md", "docs/eval-report-kit/BLIND-TEST.md", "docs/eval-report-kit/GENERATOR.md", "docs/eval-repor