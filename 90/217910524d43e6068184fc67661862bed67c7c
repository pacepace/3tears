 "packages/evals/src/threetears/evals/analysis/reporter_kind.py", "packages/evals/src/threetears/evals/kernel/failed_call.py", "packages/evals/src/threetears/evals/ops/analyst.py", "packages/evals/src/threetears/evals/ops/judge_cases.py", "packages/evals/src/threetears/evals/ops/report_writer/analyst.py", "packages/evals/src/threetears/evals/ops/report_writer/editor.py", "packages/evals/src/threetears/evals/ops/report_writer/loop.py", "packages/evals/src/threetears/evals/ops/report_writer/rubric.py", "packages/evals/src/threetears/evals/ops/report_writer/tally.py", "packages/evals/src/threetears/evals/ops/report_writer/write.py", "packages/evals/src/threetears/evals/ops/report_writer/writer_bank.py", "packages/evals/src/threetears/evals/ops/report_writer/writer_contract.py", "packages/evals/src/threetears/evals/ops/report_writer/writer_kind.py", "packages/evals/src/threetears/evals/ops/report_writer/writer_launch.py", "packages/evals/src/threetears/evals/ops/report_writer/writer_promotion.py", "packages/evals/src/threetears/evals/run/judge_kind.py", "packages/evals/tests/host_vocabulary_register.py", "packages/evals/tests/report_writer_support.py", "packages/evals/tests/test_action_catalogue.py", "packages/evals/tests/test_analyst_report_check.py", "packages/evals/tests/test_analyst_skill.py", "packages/evals/tests/test_analyst_skill_exports.py", "packages/evals/tests/test_host_contract.py", "packages/evals/tests/test_no_host_names_in_shared_contract.py", "packages/evals/tests/test_refusal_remedies_exist.py", "packages/evals/tests/test_report_doc_facts_exports.py", "packages/evals/tests/test_report_writer_bank.py", "packages/evals/tests/test_report_writer_exports.py", "packages/evals/tests/test_report_writer_kind.py", "packages/evals/tests/test_report_writer_launch.py", "packages/evals/tests/test_report_writer_skill_version.py", "packages/evals/tests/test_skill_ledger.py", "packages/evals/tests/test_writer_actions.py", "packages/evals/tests/test_writer_promotion.py", "packages/evals/tests/test_writer_template_create.py", "packages/evals/tests/writer_case_support.py", "packages/evals/tests/writer_promotion_support.py"], "files_oracle": [".prawduct/artifacts/build-plan-skills-under-test.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "Test evidence is stale: no recorded run covers HEAD", "recommendation": "Scope: instance. `prawduct-hook test-status` exits 1 with 'stale: no .test-evidence.json on disk', so nothing records that the evals suite passes at 902179105. This is a cumulative review, so stale evidence is a WARNING. Run the evals suite on the testament pool and the integration suite before merging into report-kit/analyst, and record the evidence. The plan's 'default write is unchanged (replay tests green)' and every chunk's Done-when are only shown by that run.", "fid": "R-1"}, {"goal": "Nothing Is Missing", "severity": "warning", "title": "The writer's objective measures declare no merit axis, so the promotion read never sees them", "recommendation": "Scope: instance. Every descriptor in WRITER_KIND_MEASURES is built by `_count` (writer_contract.py:172-187) or inline (192-252), and none sets `merit_axis`, so each takes MetricDescriptor's default of None. The comparison families admit a measure only when `axis_in_question_scope(descriptor.merit_axis, axes)` is true (analysis/bundle/comparisons.py:356-367), and that predicate is false for axis None (kernel/declaration.py:462). As a result, no bounce count, must_fix/should_fix open count or `finished` rate ever becomes a contrast verdict, and writer_promotion (writer_promotion.py:190-191) gates only the judged rubric dims and the engine's core measures. Failure scenario: a candidate skill edit that doubles unparsed and shape bounces and leaves more must_fix findings open, but whose stored pages the scoring judge rates higher, reads 'promote'. Those regressions are exactly the ones R-2 says the gate must catch. 02b made each bounce kind a measure, but the gate still cannot see any of them. No test catches this: test_writer_promotion.py drives the read with the toy host's measures (field_accuracy, cost_usd), never a writer measure. Fix: give each directional writer measure a merit axis, or declare the must-not-worsen ones (bounces, must_fix_open, finished) as guardrails. Then add a promotion test where a writer measure regresses and the read answers keep. If leaving them out of the gate is intended, record that in the plan as a descoping.", "fid": "R-2"}, {"goal": "Nothing Is Broken", "severity": "warning", "title": "The in-loop editor's review is parsed against the shipped rubric, not the arm's editor.md", "recommendation": "Scope: instance. editor.py:77 now reads `_RUBRIC` from `shipped_rubric()`, the build's own editor.md, once at import, and `_items`/`_item` (editor.py:472-512) refuse any review whose item count or names differ from it. The skill lever's digest covers editor.md, and the plan keeps 'the in-loop editor ... part of the arm under test'. Failure scenario: an arm whose candidate skill renames, adds or reorders an editor rubric item gives its editor that rubric (instance.skill.editor(), writer_kind.py:501). The editor scores against it, and every review is refused as unreadable. The loop then ends `review_failed` (loop.py:91), which counts against the candidate (candidate_errors). The gate would record the change as a broken writer when it is really the parser that is pinned. PASS_TOTAL (editor.py:83) is pinned the same way. The hardcoded tuple this replaced had the same limit, and there is no pre-existing exception: it matters now because editor.md is a lever. Fix: parse each review against the rubric read from the editor SkillText the session was given (`_read` already takes text). Or refuse at prepare or launch a skill whose editor rubric differs from the shipped one, and record that the editor rubric is not yet a lever. Either way, add a test with an arm whose editor.md changes an item.", "fid": "R-3"}, {"goal": "Nothing Is Missing", "severity": "note", "title": "record-lint: only chunk 01's deliverables were graded, and that chunk was inferred", "recommendation": "Scope: none. Relayed from the manifest's record_lint: 'unchecked: chunk-ref-missing graded chunk 01 of .prawduct/artifacts/build-plan-skills-under-test.md: chunk 01 was inferred as the plan's first open chunk (`plan_status.current_chunks`) because the dispatch carried no chunk'. findings is [] and every count is 0. chunks_graded is ['01'], so chunks 02, 02b, 03, 04, 05 and 05b were not machine-graded, and this is an assumption, not a clean result. By hand, chunks 02b and 05b's named deliverables exist in HEAD: the launcher, the typed Tally.bounces(), the public MOST_REVISIONS, kernel/failed_call.py, the retire op, and the four catalogue actions.", "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "writer_template_create is a near-copy of judge_template_create, and the copies already drift", "recommendation": "Scope: class. writer_bank.py:651-700 (writer_template_create) repeats ops/judge_cases.py:345-399 (judge_template_create) step for step: the same `KIND not in host.launch.kinds` refusal, the same load_template_by_name ConflictError, the same EvalTemplate build and the same hand-built TemplateLine. Only the kind, the rubric and the remedy wording differ. They have already drifted. The judge's refusal tells the operator the profile must also declare JUDGE_KIND_CONTRACT (judge_cases.py:370-372). The writer's refusal (writer_bank.py:673-677) names only the registry entry, so an operator who registers launchable_report_writer_kind but leaves WRITER_KIND_CONTRACT off the profile is told nothing about it. Fix by construction: add one helper that creates a template for a kind (host, kind, create, scope_id, rubric, a pre-save check, and the operator's enablement hint) and move both create operations onto it. To bound the class, search ops/ for `launches no` and for `load_template_by_name(create.template_name`.", "files": ["packages/evals/src/threetears/evals/ops/report_writer/writer_bank.py", "packages/evals/src/threetears/evals/ops/judge_cases.py"], "fid": "R-5"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "The ending measure's categories are a hand copy of WriterEnding, the class 02b fixed for bounce kinds", "recommendation": "Scope: instance. writer_contract.py:149-156 declares `_ENDINGS` as a literal tuple of the six values of loop.py:88's `WriterEnding`. That tuple is the `categories` of the categorical ENDING_MEASURE descriptor (writer_contract.py:200). Chunk 02b moved BOUNCE_MEASURES onto `get_args(BounceKind)` (writer_contract.py:132-134) precisely so that a value the loop adds is measured with it, but the endings were left behind. No test holds the two equal: test_report_writer_kind.py:304-309 checks only data types. Consequence: if the loop gains an ending, every cell that ends that way lands an ENDING_MEASURE value its own descriptor does not list, and nothing goes red until a real run trips on it. Fix: `_ENDINGS: tuple[WriterEnding, ...] = get_args(WriterEnding)`.", "files": ["packages/evals/src/threetears/evals/ops/report_writer/writer_contract.py"], "fid": "R-6"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "A writer case's identity reads its frozen snapshot by bare string keys", "recommendation": "Scope: instance, three sites. WriterCase.snapshot is `dict[str, Any]` (writer_kind.py:148). Its source_key reads `self.snapshot.get(\"campaign_id\")` and `.get('report_input_digest')` (writer_kind.py:189-192). The mint's repeat-or-refuse check reads `case.snapshot.get(\"id\")` (writer_bank.py:379-382). This is the R-7 shape again: EvalReportSnapshot is the typed producer, and these readers are invisible to the type checker. If any of the three fields is renamed, `.get` returns None without an error. Every bare snapshot then keys as `report-input:None` and collapses into one source, campaign cases re-key, and the one-source-one-case dedup, the differs-refusal and archive's restore-rival check (writer_bank.py:522) all misfire silently. Keeping the snapshot as raw JSON is deliberate, so an old case still reads. Keep that, but read the identity through the model, for example a WriterCase property that validates `snapshot` into EvalReportSnapshot once and reads `.id`, `.campaign_id` and `.report_input_digest`. Alternatively, pin the three names with a test against `EvalReportSnapshot.model_fields`.", "files": ["packages/evals/src/threetears/evals/ops/report_writer/writer_kind.py", "packages/evals/src/threetears/evals/ops/report_writer/writer_bank.py"], "fid": "R-7"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "The serving guide's writer section skips the launch, where the reporter and judge sections each give it", "recommendation": "Scope: instance. docs/serving.md:723-736 (\"Writer campaigns\", added in this changeset) lists template create, case mint, case archive and the promotion read, then stops. It never says how the cases are run. The reporter section (serving.md:718) and the judge section (serving.md:754-756) both name the run_launch step. The step a host needs is: run_launch the template with `case_set` naming the held-out set, and name the same `judge_model` for every arm. admit_writer_launch refuses a launch with no judge (writer_launch.py:176-180). With no case_set, the launch runs the template's live cases on both sides (writer_launch.py:120). writer_promotion then refuses that campaign as not held-out (writer_promotion.py:91-116). Concrete wrong action: a host following the guide launches without case_set and pays for a whole writer campaign that the promotion read will never decide on. Add the launch bullet: case_set as the held-out set, one judge_model across arms, and the judge from another model family. Also add one line saying the host enables the kind by registering launchable_report_writer_kind and declaring WRITER_KIND_CONTRACT and WRITER_KIND_MEASURES on its profile.", "files": ["packages/evals/docs/serving.md"], "fid": "R-8"}, {"goal": "The Design Is Sound", "severity": "note", "title": "The skills a writer launch may run are resolved twice, with different checks", "recommendation": "Scope: instance. writer_launch.py:85-96 (_skill) and ReportWriterKind (writer_kind.py:349-352 and 395-401) each build `{shipped.digest: shipped, **skills}` and refuse an arm whose skill digest is absent, with near-identical messages. The kind refuses a mapping keyed by a foreign digest. The launch instead checks `skill.digest != overlays.skill` after lookup. One resolver (a small value built once from `skills`, validated once, and handed to both) would give one rule for which skills a launch may run.", "files": ["packages/evals/src/threetears/evals/ops/report_writer/writer_launch.py", "packages/evals/src/threetears/evals/ops/report_writer/writer_kind.py"], "fid": "R-9"}, {"goal": "The Design Is Sound", "severity": "note", "title": "The editor's item names are now parsed from editor.md at import, so the whole engine catalogue's import depends on that regex", "recommendation": "Scope: instance. editor.py:77 computes `_RUBRIC` at module import from shipped_rubric(), a regex parse of the shipped editor.md. The import chain is actions/engine.py, then writer_bank, writer_contract, loop and editor. So if an editor.md edit breaks the rubric's line shape, `import threetears.evals.actions.engine` raises ValueError and takes every action down with it, not just the writer. A single source for the rubric is the right call. Reading it lazily, inside the editor's answer check, would confine a malformed rubric to the code that reads it. Leaving it fail-fast is defensible if a test of shipped_rubric() is considered enough; the choice is yours.", "files": ["packages/evals/src/threetears/evals/ops/report_writer/editor.py"], "fid": "R-10"}, {"goal": "The Design Is Sound", "severity": "note", "title": "The promotion read's generic decision is fused to writer cases", "recommendation": "Scope: none, for wave 2. The plan's Goals say the gate is generic over a kind's levers, with the writer as its first subject, not its only one. writer_promotion (writer_promotion.py:145-222) is generic in its lever diff, gate reading and cost read. Its held-out check (_refuse_unheld_out, lines 91-118) reads writer_case_bank and WriterCaseOrigin directly, so a host kind with a quantization lever cannot use it. No change is wanted now. When wave 2 plans its search over other kinds, split the held-out check into a per-kind seam rather than copying the read.", "files": ["packages/evals/src/threetears/evals/ops/report_writer/writer_promotion.py"], "fid": "R-11"}, {"goal": "The Design Is Sound", "severity": "note", "title": "The flat mint parameters re-declare WriterSplit's and WriterCaseMint's constraints", "recommendation": "Scope: instance. WriterCaseMintParams (actions/engine.py:733-756) borrows each field's description and default from WriterCaseMint and WriterSplit model_fields (lines 729-730), but writes their constraints out again (`min_length=1`, `gt=0, lt=1`). mint() re-validates through the real models, so behaviour holds. If a bound changes on WriterSplit, though, the tool schema hosts read keeps advertising the old one. Taking the constraint metadata from the same FieldInfo, as the descriptions already are, removes the second copy.", "files": ["packages/evals/src/threetears/evals/actions/engine.py"], "fid": "R-12"}, {"goal": "The Design Is Sound", "severity": "note", "title": "Two test builders of the writer toy host", "recommendation": "Scope: instance. test_report_writer_kind.py:108-117 (_host) and writer_case_support.py:60-77 (writer_host) build the same profile: the toy profile plus writer_kind_contract(host_seats=(\"reviewer_pool\",)) and a MeasureRegistry of TOYHOST_MEASURES plus WRITER_KIND_MEASURES. Chunk 02's test predates chunk 04's support module. Have _host call writer_host (or a profile-only helper split out of it), so a change to the writer's host contract is made once.", "files": ["packages/evals/tests/test_report_writer_kind.py", "packages/evals/tests/writer_case_support.py"], "fid": "R-13"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "Goals still marked inferred, and per-case withholding is now a host-facing action shape", "recommendation": "Scope: instance. Prior R-11 still holds at HEAD. The plan's '## Goals' keeps four items under 'Inferred (not owner words)' (.prawduct/artifacts/build-plan-skills-under-test.md:25-29): the ~12-case dev/held-out split, gemini flash as the scoring judge, per-case withholding, and regression as the same A/B. Mid-build decisions added two more inferred defaults: held_out_fraction 0.3 and the 'writer-split:' prefix (line 53), and a possible later 'measured required' switch (line 116). Per-case withholding has moved since the prior review. It was built into WriterCase.withhold (packages/evals/src/threetears/evals/ops/report_writer/writer_kind.py:179). It is now also the public parameter of the writer_case_mint catalogue action that hosts call (packages/evals/src/threetears/evals/actions/engine.py:2600-2618). The split fraction decides which side every new group lands on, and a group keeps its recorded side. Consequence: if the owner rules otherwise on withholding or the split, hosts (Discodon, metallm) have already minted cases under the inferred shape. Stored cases never change (decision 04), so each one would have to be retired and minted again. The gemini item is now moot in code: a launch must name its judge (packages/evals/src/threetears/evals/ops/report_writer/writer_launch.py:176-180). Get an owner ruling on withholding and the split fraction before hosts start minting, and mark the judge-model item as settled by the launch argument. Or record why each item stays inferred.", "files": [".prawduct/artifacts/build-plan-skills-under-test.md", "packages/evals/src/threetears/evals/actions/engine.py", "packages/evals/src/threetears/evals/ops/report_writer/writer_kind.py"], "fid": "R-14"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Mid-build decisions for the owner, and one alignment-pass miss", "recommendation": "Scope: none. Each decision recorded at .prawduct/artifacts/build-plan-skills-under-test.md:44-59, with what settled it. (01) Both roles' texts are built before the freeze, so an unknown withheld note is refused with nothing spent; settled by the existing refusal order. (02 step 0) The writer has its own cell deadline; settled by recorded Opus runs at 682-985 s. Wired in 02b: the launcher passes KindWiring.cell_timeout_s from writer_launch_deadline (packages/evals/src/threetears/evals/actions/report_writing.py:318), and test_report_writer_launch.py:138-147 pins the run's deadline with origin 'kind'. (02) The kind lives in ops/report_writer/ because analysis may not import ops; settled by the layering rule. (02) An arm that names no skill records the shipped digest, not None; recorded as a departure from the brief. (02) Effort is a lever, through a host WriterModels factory. (02) A WriterCase embeds the whole snapshot. Caveat: analyst tools still read the host's live store for other documents, so a case does not fully pin its inputs. (02) invoke drives write_rounds directly and stores no document. (04) Cases are keyed on their source and are immutable; a re-mint is idempotent and a moved source is refused. (04) The split is by group, by hash against a 0.3 fraction; inferred, see the warning above. (04) case_version 1 with origin. (02b) Judge family is answered by a host hook (ModelFamily); 'unchecked' is recorded on the run when a model cannot be placed. One failure-owner helper (kernel/failed_call.py). All five bounce kinds are measures. (05) writer_promotion maps gate_verdicts to keep, undecided or promote. It refuses a moved judge and any non-held-out case. It never writes; a person records the call and the ledger entry. The ledger is PROMOTIONS.toml, and the baseline is seeded as unmeasured. (05b) Four catalogue actions; the split is flattened because the catalogue refuses nested models. (03) The scoring rubric is sourced from the shipped editor.md and frozen into the template at creation. Owner-facing consequence: promoting a new editor.md changes the scoring rubric for templates created after that, so campaigns across a promotion are scored on different rubrics. (03) refuse_unfixed_scoring_judge exists because the engine only reports a judge change and does not refuse one. Alignment-pass miss: chunk 05's body (line 114) still names `skill_promotion(campaign)` and says a promotion 'is recorded as a CampaignCall' (line 115). Decision 05 superseded both: the read is writer_promotion(host, campaign_id, scope_id, *, candidate) and it never writes (packages/evals/src/threetears/evals/ops/report_writer/writer_promotion.py:25-27,145). Line 46 still says 'the kind sets its own deadline', but the launcher sets it. Chunk 06's builder reads these chunk bodies. Prior R-10 verdict: resolved. The launcher exists (launchable_report_writer_kind) and wires the deadline under test. The contract and measures remain in the awaiting-a-caller list on purpose, because a host profile declares them (packages/evals/tests/test_report_writer_exports.py:44-45).", "files": [".prawduct/artifacts/build-plan-skills-under-test.md"], "fid": "R-15"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "Promotion read silently drops a campaign run that no longer loads", "recommendation": "Scope: instance. writer_promotion builds its run list with `if (run := host.storage.load_eval_run(run_id, scope_id)) is not None` (packages/evals/src/threetears/evals/ops/report_writer/writer_promotion.py:166). A run the campaign names but the store cannot return is skipped with no log and no field on WriterPromotion. The judge-fixity check and the held-out check then run over