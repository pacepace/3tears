/examples/basic/lab/engine.js", "web/examples/basic/lab/index.html", "web/examples/basic/lab/page.js", "web/examples/basic/lab/tone-dep.js", "web/examples/basic/lab/tone.js", "web/examples/browser/safe-area.test.js", "web/examples/browser/workers.test.js", "web/examples/server.js", "web/packages/pwa/README.md", "web/packages/pwa/src/safe-area.css", "web/packages/pwa/src/shell-worker.js", "web/packages/pwa/test/shell-worker.test.js"], "files_oracle": [".prawduct/artifacts/build-plan-web-pwa.md"], "findings": [{"goal": "Decisions Were Deliberate", "severity": "note", "title": "Learnings Cross-Check: no learnings corpus applies to this diff", "recommendation": "Scope none. `prawduct-hook learnings-files --for-diff` printed nothing and the worktree has no .claude/rules/learnings/ directory, so no rule was in the session's context. Nothing to escalate, and no rules were added or changed this cycle.", "fid": "R-1"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Backlog Reconciliation: no open item is resolved by this change", "recommendation": "Scope none. The worktree has no .prawduct/project-state.yaml, so backlog_service_repo could not be read; the scope pacepace/3tears was inferred from the prior dispositions' citations (#493). `cache-query affecting` on shell-worker.js, safe-area.css, the pwa README, docs/adoption/web-pwa.md and web/examples/server.js returned no items, and searches for pwa, worker, safe-area and WebKit returned none either (store synced 2026-11-17T00:19Z, about 47 min old). C-B1 to C-B4: nothing to flag.", "fid": "R-2"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Records Pass: the oracle set clears no bar", "recommendation": "Scope none. Covered: .prawduct/artifacts/build-plan-web-pwa.md, the only oracle file. Its two new DECISION entries match the code: destinations worker/sharedworker/serviceworker/audioworklet/paintworklet, worker clients from resultingClientId or a single clients.get, and *worker*.js/*worklet*.js entries dropped with a warning; the safe-area additions are the ones shipped. Nothing ships false, misleads into action or should stop the merge. The front matter still reads branch feat/web-pwa and last_validated 2026-11-16, which is why critic-begin found no live plan claiming this branch (scope_unresolved_cause no-claim). That is narration and clears no bar.", "fid": "R-3"}], "counts": {"blocking": 0, "warning": 0, "note": 3}, "observations": [{"goal": "Nothing Is Broken", "title": "Test evidence is stale: the suite is owed before this lands", "recommendation": "`prawduct-hook test-status` reports `stale: no .test-evidence.json on disk`. Run the web suite (`npm run check` in web/, which includes test:browser with the new workers.test.js and safe-area.test.js) and record evidence before pushing.", "files": ["web/packages/pwa/test/shell-worker.test.js", "web/examples/browser/workers.test.js", "web/examples/browser/safe-area.test.js"], "oid": "O-1"}, {"goal": "Nothing Is Broken", "title": "The worker-client gap is wider than the README states, and on WebKit (the target) it is unverified", "recommendation": "isWorkerLoad only knows a worker client from `resultingClientId` on its script request, or after `clients.get` resolves. Until that promise resolves, every request from an unknown worker client (not just the first) falls through to the shell check and is answered if listed. The README calls this 'the one gap: the first from a worker that started before the service worker last restarted'. The decision records probes in Chromium and Firefox only, so if WebKit leaves `resultingClientId` empty on worker script requests, the gap covers every worker's early dynamic import()/importScripts/fetch, on the platform whose stall motivated the change. Either confirm WebKit sets resultingClientId (record it next to the decision), or reword the README gap to 'requests from a worker client before its lookup completes'. Worker-named files are dropped up front either way, so the station's real files are covered.", "files": ["web/packages/pwa/src/shell-worker.js", "web/packages/pwa/README.md"], "oid": "O-2"}, {"goal": "Nothing Is Broken", "title": "Client memory eviction can make a known worker's requests answerable again (untested)", "recommendation": "remember() clears a whole set when it reaches 512. lookedUp gains every window client id (one per page load), and workerClients is cleared separately. After workerClients is cleared, a long-lived worker whose id is still in lookedUp is never looked up again (learnClient returns early), so its later requests to shell paths are answered. Unlikely at the station's scale. A cheap fix is to delete the id from lookedUp when it is evicted, or clear both sets together. No test exercises eviction.", "files": ["web/packages/pwa/src/shell-worker.js"], "oid": "O-3"}, {"goal": "Nothing Is Unintended", "title": "safe-area.css now sets html's background, which can override an app's own html background", "recommendation": "`html { background-color: var(--safe-background); }` is inert only if no app rule on html comes earlier in the cascade. An app that sets `html { background: ... }` in a stylesheet loaded before safe-area.css (same specificity, so the later rule wins) gets a transparent root once it takes this version. The example loads safe-area.css first, so it is unaffected, and the package is still Unreleased. Note in the README's safe-area section that an app should set --safe-background rather than styling html, or load its own CSS after safe-area.css.", "files": ["web/packages/pwa/src/safe-area.css", "web/packages/pwa/README.md"], "oid": "O-4"}, {"goal": "Nothing Is Unintended", "title": "Warning text says worker scripts are never cached, but listed files that are not named like workers still are", "recommendation": "The drop warning says worker and worklet scripts 'are never cached or answered'. But install still caches listed worker files that are not named like workers (workers.test.js asserts engine.js, tone.js and others are cached), and the worker only refuses to answer them. noteWorkerLoad's 'remove it from shell' is also wrong for a module the page imports as well as a worker, since the page needs it offline. This is prose only: say 'never answered', and qualify the removal advice.", "files": ["web/packages/pwa/src/shell-worker.js"], "oid": "O-5"}, {"goal": "Nothing Is Unintended", "title": "WORKER_NAME matches any file whose name contains 'worker' or 'worklet'", "recommendation": "`/(worker|worklet)[^/]*\\.m?js$/i` also drops page scripts like `networker.js` or `coworkers.js` from the shell. They then silently lose offline service, with only a console warning. Consider anchoring on a word boundary or separator (`(^|[-_.])(worker|worklet)`). README documents the pattern as `*worker*.js`, so behaviour matches the docs.", "files": ["web/packages/pwa/src/shell-worker.js"], "oid": "O-6"}, {"goal": "The Design Is Sound", "title": "safe-area.css now claims html's background-color, which overrides a consumer's own html background whenever the library sheet loads after it", "recommendation": "Instance. `html { background-color: var(--safe-background); }` has the same specificity as a consumer's `html { background: ... }`, so source order decides; with --safe-background unset the declaration computes to transparent and wipes the consumer's colour (the station's player.css, for one, sets `html { background: var(--color-stage); }`). The comment only covers the body-propagation case. Make the library rule lose to any author rule: `:where(html) { background-color: var(--safe-background); }` (zero specificity), and keep the existing test that sets --safe-background.", "files": ["web/packages/pwa/src/safe-area.css"], "oid": "O-7"}, {"goal": "The Design Is Sound", "title": "Two mechanisms enforce one policy: the name heuristic duplicates the runtime pass-through and can drop a legitimate page script", "recommendation": "Instance. isWorkerLoad (destination plus worker-client tracking) already guarantees worker loads are never answered; WORKER_NAME additionally removes any shell entry whose name matches /(worker|worklet)[^/]*\\.m?js$/ (e.g. a page module `coworker-list.js` or `worklet-demo-ui.js` would lose its offline copy), while worker files with ordinary names (engine.js, tone.js) are still precached at install, as workers.test.js asserts. Either keep the name check as a warning only (no drop), or state that it is a precache optimisation, not the enforcement.", "files": ["web/packages/pwa/src/shell-worker.js"], "oid": "O-8"}, {"goal": "The Design Is Sound", "title": "Worker-client memory: two sets that must agree are evicted independently", "recommendation": "Instance, borderline (NOTE). workerClients and lookedUp are each cleared wholesale at 512 by remember(). If workerClients clears while lookedUp still holds a worker id learned by lookup, learnClient returns early for it and that worker's later shell-listed loads are answered, which the policy forbids. One map from client id to type (worker|window), cleared as a unit, removes the disagreement. Only reachable after 512 distinct clients in one service-worker lifetime.", "files": ["web/packages/pwa/src/shell-worker.js"], "oid": "O-9"}, {"goal": "Everything Is Coherent", "title": "Docs overstate the guarantees: 'never cached' and 'a script load is the one gap'", "recommendation": "Instance, prose (NOTE). The drop warning says worker scripts 'are never cached or answered', but a listed worker file without a worker-like name is cached at install (workers.test.js asserts it). The README's '(so a `script` load is the one gap ...)' is narrower than the code: any first request from a worker that predates a service-worker restart is answered if listed, a plain fetch (destination \"\") included, and the async clients.get lookup leaves a window for concurrent requests too. Make both claims relational to the code (drop 'cached'; say 'the first request from such a worker') rather than enumerating.", "files": ["web/packages/pwa/src/shell-worker.js", "web/packages/pwa/README.md"], "oid": "O-10"}, {"goal": "The Design Is Sound", "title": "Chromium launch/skip harness copied into each new browser test", "recommendation": "Class: workers.test.js and safe-area.test.js copy basic.test.js's before/after block (startExample, chromium.launch with the same args, THREETEARS_REQUIRE_CHROMIUM handling, skip message) and say so in their headers. Search web/examples/browser/*.test.js; extract one helper (e.g. browser/harness.js exporting a setup that returns {app, browser, skip}) so the skip policy has one owner.", "files": ["web/examples/browser/workers.test.js", "web/examples/browser/safe-area.test.js"], "oid": "O-11"}, {"goal": "Decisions Were Deliberate", "title": "The new family rule 'never answer a worker's or worklet's loads' is wider than its recorded decision, and appShell does not follow it", "recommendation": "Scope class: any family worker path other than shell-worker.js. The plan's DECISION (owner, 2026-11-17) covers only `shell-worker.js`. The README puts the rule under 'Agreed for the family (2026-11-09)' as a convention for every app, and the adoption doc states it without qualification. The Workbox path (`appShell` in workbox.js, metallm's) runs `precacheAndRoute` over the build's precache list, which for a Vite build includes emitted worker chunks, so it serves them from the cache. Consequence: a maintainer reading the family convention assumes metallm's worker loads pass through, and they do not. Either record a decision that appShell is in scope and enforce the rule there (exclude worker/worklet destinations, or a precache filter), or narrow the README and adoption-doc rule to shell-worker.js and record why Workbox apps are exempt. The 2026-11-09 heading also now dates a 2026-11-17 rule.", "files": ["web/packages/pwa/README.md", "docs/adoption/web-pwa.md", "web/packages/pwa/src/shell-worker.js"], "oid": "O-12"}, {"goal": "The System Can Be Understood", "title": "Worker-client memory eviction can lose a known worker for good", "recommendation": "Scope instance (shell-worker.js remember/learnClient). The memory is bounded, but `workerClients` and `lookedUp` are cleared independently at 512 entries. After `workerClients` clears, a worker whose id is still in `lookedUp` is never looked up again, because `learnClient` returns early. Its listed requests are then answered by the shell, with no warning, until `lookedUp` also happens to clear. Clear both sets together, or drop the id from `lookedUp` whenever `workerClients` evicts it.", "files": ["web/packages/pwa/src/shell-worker.js"], "oid": "O-13"}, {"goal": "The System Can Be Understood", "title": "A failed client lookup leaves no trace", "recommendation": "Scope instance. `learnClient` swallows a `clients.get` rejection with `() => {}`. The id stays in `lookedUp`, so the client is never classified, and a worker behind it would have its listed loads answered with no record of why. This is the very failure the change exists to prevent, and it surfaced only as a stalled worker. A console.warn with the PREFIX, like the module's other two warnings, would make it diagnosable.", "files": ["web/packages/pwa/src/shell-worker.js"], "oid": "O-14"}, {"goal": "Decisions Were Deliberate", "title": "Mid-build decisions this round, for the owner", "recommendation": "Scope none. Two decisions were added to build-plan-web-pwa.md, both settled by the owner on 2026-11-17. (1) shell-worker.js passes worker and worklet loads through, based on the station's v0.8.0-v0.8.1 iPhone stall and destination/resultingClientId probes in Chromium and Firefox. (2) safe-area.css gains .safe-area-backdrop, --safe-full-height and --safe-background, generalised from the station's PR #26 fix for WebKit bug 301994. Alignment-pass miss: decision (1) was recorded for shell-worker.js only, while the README states it as a family-wide rule (see the observation above). No new dependency.", "oid": "O-15"}], "duration_seconds": 420, "scope": null, "scope_chosen_by": "none", "scope_unresolved_cause": "no-claim", "scope_reason": "no live plan claims `feat/web-pwa-worker-passthrough-ios-gap`", "base_extended_from": null, "chunks": [], "chunks_proposed": [], "chunk": null, "base_reviewed": null, "record_lint": {"records": [".prawduct/artifacts/build-plan-web-pwa.md", "CHANGELOG.md", "docs/adoption/web-pwa.md", "web/packages/pwa/README.md"], "chunk_graded": null, "chunks_graded": [], "plan_graded": null, "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": null, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasoned": 0, "learnings-core-raise-unapproved": 0, "learnings-rule-too-long": 0, "learnings-rule-body": 0, "learnings-area-dead": 0, "change-fragment": 0, "retired-claim-survives": 0}}, "dispatched_at": "2026-11-17T01:06:02Z"}}

