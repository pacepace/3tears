data: {"model":"brave-pro","system_fingerprint":"","choices":[{"delta":{"role":"assistant","content":"<citation>{\"start_index\": 89, \"end_index\": 89, \"number\": 3, \"url\": \"https://www.reddit.com/r/Naturewasmetal/comments/ffbdqj/josephoartigasia_was_the_largest_rodent_ever/\", \"favicon\": \"https://imgs.search.brave.com/U-eHNCapRHVNWWCVPPMTIvOofZULh0_A_FQKe8xTE4I/rs:fit:32:32:1:0/g:ce/aHR0cDovL2Zhdmlj/b25zLnNlYXJjaC5i/cmF2ZS5jb20vaWNv/bnMvN2ZiNTU0M2Nj/MTFhZjRiYWViZDlk/MjJiMjBjMzFjMDRk/Y2IzYWI0MGI0MjVk/OGY5NzQzOGQ5NzQ5/NWJhMWI0NC93d3cu/cmVkZGl0LmNvbS8\", \"snippet\": \"r/Awwducational \\u2022 The Capybara is the largest living rodent in the world which can grow up to 1.3 meters long and weigh up to 79 kg! r/Awwducational - The Capybara is the largest living rodent in the world\\u2026\"}</citation>"},"finish_reason":null}],"created":1792844218,"id":"f0599464-5522-4ae1-8a10-1d936f113325","object":"chat.completion.chunk","usage":null}

data: {"model":"brave-pro","system_fingerprint":"","choices":[{"delta":{"role":"assistant","content":"<citation>{\"start_index\": 89, \"end_index\": 89, \"number\": 4, \"url\": \"https://animals.howstuffworks.com/mammals/largest-rodent.htm\", \"favicon\": \"https://imgs.search.brave.com/Lo2CxwEkm2n_yud3C_m_HHSHNL8n0nm_yC_9lQEpEKU/rs:fit:32:32:1:0/g:ce/aHR0cDovL2Zhdmlj/b25zLnNlYXJjaC5i/cmF2ZS5jb20vaWNv/bnMvMTA1NGMxZjY2/NTZmODQ0NzM1ZjNk/YmEwNWJhZDA1ODlh/N2YyZTU2MThhOWE1/MWM0OTJlMjMzYzFk/Y2MyZDM3OC9hbmlt/YWxzLmhvd3N0dWZm/d29ya3MuY29tLw\", \"snippet\": \"Capybara (Hydrochoerus hydrochaeris)\\nMeet the largest living rodent: the capybara (*Hydrochoerus hydrochaeris*). The largest adult capybaras can reach up to 150 pounds (68 kilograms) and measure around 4 feet (1.2 meters) in body length\"}</citation>"},"finish_reason":null}],"created":1792844218,"id":"f0599464-5522-4ae1-8a10-1d936f113325","object":"chat.completion.chunk","usage":null}

data: {"model":"brave-pro","system_fingerprint":"","choices":[{"delta":{"role":"assistant","content":"<citation>{\"start_index\": 89, \"end_index\": 89, \"number\": 5, \"url\": \"https://www.reddit.com/r/Awwducational/comments/151ulvs/the_capybara_is_the_largest_living_rodent_in_the/\", \"favicon\": \"https://imgs.search.brave.com/U-eHNCapRHVNWWCVPPMTIvOofZULh0_A_FQKe8xTE4I/rs:fit:32:32:1:0/g:ce/aHR0cDovL2Zhdmlj/b25zLnNlYXJjaC5i/cmF2ZS5jb20vaWNv/bnMvN2ZiNTU0M2Nj/MTFhZjRiYWViZDlk/MjJiMjBjMzFjMDRk/Y2IzYWI0MGI0MjVk/OGY5NzQzOGQ5NzQ5/NWJhMWI0NC93d3cu/cmVkZGl0LmNvbS8\", \"snippet\": \"# The Capybara is the largest living rodent in the world which can grow up to 1.3 meters long and weigh up to 79 kg!\\n## vikas_agrawal77\\n\\u2026he Capybara, also known as carpincho or water hog, is a large semiaquatic rodent native to South America, inhabiting forests and wetlands from Panama to Argentina. The larger species, called Hydrochoerus hydrochaeris, is the largest living rodent in the worl\\u2026\"}</citation>"},"finish_reason":null}],"created":1792844218,"id":"f0599464-5522-4ae1-8a10-1d936f113325","object":"chat.completion.chunk","usage":null}

data: {"model":"brave-pro","system_fingerprint":"","choices":[{"delta":{"role":"assistant","content":"<citation>{\"start_index\": 89, \"end_index\": 89, \"number\": 6, \"url\": \"https://capybaramag.com/worlds-largest-rodents/\", \"favicon\": \"https://imgs.search.brave.com/LlwxjPTB7H3AL02Ew8eiM5abmoeTfmHIySe8MT9xr30/rs:fit:32:32:1:0/g:ce/aHR0cDovL2Zhdmlj/b25zLnNlYXJjaC5i/cmF2ZS5jb20vaWNv/bnMvZmM5MmNiODBm/M2M0ODg4NDhkMGQ0/OGM5NmQ5YmM2YmEz/NGU3YzMzYjdhMzRk/OGVmZjk2ZjQ3NmY0/NDdiZTNmNi9jYXB5/YmFyYW1hZy5jb20v\", \"snippet\": \"Capybara (Hydrochoerus Hydrochaeris)\\nThe **Capybara holds the title of the largest living rodent in the world**. Native to **South America, particularly Brazil, Colombia, and Venezuela**, these semi-aquatic mammals can reach up to **4.4 feet in length**\\u2026\"}</citation>"},"finish_reason":null}],"created":1792844218,"id":"f0599464-5522-4ae1-8a10-1d936f113325","object":"chat.completion.chunk","usage":null}

data: {"model":"brave-pro","system_fingerprint":"","choices":[{"delta":{"role":"assistant","content":"<citation>{\"start_index\": 89, \"end_index\": 89, \"number\": 7, \"url\": \"https://biologyinsights.com/what-are-the-largest-rodents-in-the-world-2/\", \"favicon\": \"https://imgs.search.brave.com/KNuYc371g_Cds8i_B5k_YKxsjyTGZ7CsTqXrIcMUGkc/rs:fit:32:32:1:0/g:ce/aHR0cDovL2Zhdmlj/b25zLnNlYXJjaC5i/cmF2ZS5jb20vaWNv/bnMvNWFjZjdjM2Zi/YjYwYjU4OTBjNmEy/MjA4NTcxMGMzMGJj/M2JkYzg2YTBmYWEy/Yzc0ODI4MDQ5OWEz/ZDdiNjVkOS9iaW9s/b2d5aW5zaWdodHMu/Y29tLw\", \"snippet\": \"## The Undisputed King: The Capybara\\nThe largest living rodent in the world is the Capybara, scientifically known as Hydrochoerus hydrochaeris. This massive herbivore, a native of South America, exhibits a barrel-shaped body that can reach a length of u\\u2026\"}</citation>"},"finish_reason":null}],"created":1792844218,"id":"f0599464-5522-4ae1-8a10-1d936f113325","object":"chat.completion.chunk","usage":null}

data: {"model":"brave-pro","system_fingerprint":"","choices":[{"delta":{"role":"assistant","content":"<citation>{\"start_index\": 89, \"end_index\": 89, \"number\": 8, \"url\": \"https://en.wikipedia.org/wiki/Capybara\", \"favicon\": \"https://imgs.search.brave.com/m6XxME4ek8DGIUcEPCqjRoDjf2e54EwL9pQzyzogLYk/rs:fit:32:32:1:0/g:ce/aHR0cDovL2Zhdmlj/b25zLnNlYXJjaC5i/cmF2ZS5jb20vaWNv/bnMvNjQwNGZhZWY0/ZTQ1YWUzYzQ3MDUw/MmMzMGY3NTQ0ZjNj/NDUwMDk5ZTI3MWRk/NWYyNTM4N2UwOTE0/NTI3ZDQzNy9lbi53/aWtpcGVkaWEub3Jn/Lw\", \"snippet\": \"# Capybara\\nThe **capybara** (/k \\u00e6 p \\u026a \\u02c8 b \\u0251\\u02d0 r \\u0259/ ^\\u24d8 *kap-ih-BAR-uh*) or **greater capybara** (***Hydrochoerus hydrochaeris***) is the largest living rodent, native to all countries in South America except Chil\\u2026\"}</citation>"},"finish_reason":null}],"created":1792844218,"id":"f0599464-5522-4ae1-8a10-1d936f113325","object":"chat.completion.chunk","usage":null}

