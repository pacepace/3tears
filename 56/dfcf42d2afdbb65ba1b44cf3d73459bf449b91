findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "No test evidence for the reviewed tree: test-status reports 'stale: no .test-evidence.json on disk' (exit 1), and the accepted R-1's reason (the branch's test files at 137/137 on the pool) predates 757364a78..56dfcf42d, which add 71 lines of tests to tests/enforcement/test_ci_unit_shards.py, change tests/test_ci_unit_pool_script.py, rewrite the moved-module guard and retune two core timing tests", "recommendation": "instance: re-run the changed test files on the pool (tests/enforcement/test_ci_unit_shards.py, tests/test_ci_unit_pool_script.py, tests/enforcement/test_public_api_has_a_caller.py, and the two tests at packages/core/tests/test_scoped_snapshot_unit.py:4785 and :6008), and record the result. Or re-accept R-1 with a reason that covers these three commits. The consequence: the tests that pin the loop_timing routing and the new tag-tree read have no recorded pass at this HEAD, and only the PR's own CI run would show it. This is re-raised, not new, because R-1's cited file test_ci_unit_shards.py changed materially.", "files": ["tests/enforcement/test_ci_unit_shards.py", "tests/test_ci_unit_pool_script.py", "tests/enforcement/test_public_api_has_a_caller.py", "packages/core/tests/test_scoped_snapshot_unit.py"], "fid": "R-1"}, {"goal": "Everything Is Coherent", "severity": "note", "title": "Stale citation left behind: pyproject.toml:51 still says 'CI shards the evals session three ways'", "recommendation": "Instance. The shard count moved to eight (scripts/ci-unit-tests.sh SHARDS, ci.yml/release.yml matrices) but the dev-dependency comment on pytest-split still says three. Nothing reads the comment, so this is prose only. Make it relational ('CI splits the evals session across the evals-N shards, scripts/ci-unit-tests.sh') or delete the count. Don't restate the new number.", "files": ["pyproject.toml"], "fid": "R-2"}, {"goal": "Everything Is Coherent", "severity": "note", "title": "The outcome map in scripts/ci-unit-pool.sh:41-51 and the docs/testing.md 'CI on the testament pool' table omit that a client that cannot be had during `run` is `unreachable`", "recommendation": "Instance. run() (scripts/ci-unit-pool.sh:264-266) maps an install_client failure (download failed, sha mismatch, not a testament wheel, uv install failed) to outcome=unreachable, which sends CI to the shards. tests/test_ci_unit_pool_script.py pins this. But the header's outcome list says 'unreachable' means 'exit 2 with error.code ...', and the docs table's 'passes | unreachable' row lists only the four error codes. The annotation still names the cause, so nothing is silent. Add the client case to the header list and to that table row, or point both at the tested behaviour.", "files": ["scripts/ci-unit-pool.sh", "docs/testing.md"], "fid": "R-3"}, {"goal": "The Design Is Sound", "severity": "note", "title": ".test_durations keys hard-code the xdist group suffix '@packages/evals' (scripts/update-test-durations.sh:99), coupled to the root conftest's _package_of with no check tying them", "recommendation": "Class: any change to how conftest.py:134 names xdist groups. Every entry would then stop matching what pytest-split reads, and the 'stale entries are fine' fallback (pytest-split's average duration) would bring back the count split this change was built to remove (56 min against 22). No test would fail. The cost is CI time only, never a skipped test, hence note. A construction would close it: an enforcement test asserting that a sample of .test_durations keys equals '<nodeid>@' + the group conftest assigns that nodeid. That derives the suffix from its source instead of repeating it.", "files": ["scripts/update-test-durations.sh", ".test_durations"], "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "note", "title": "Which unit route reached a verdict is worked out in three places: unit.if, the loop_timing step gates in unit-pool, and check's case statement (ci.yml)", "recommendation": "Borderline unmodeled state, scope none. The signals: route.outputs.pool, route.result, unit-pool.outputs.outcome, unit-pool.result and unit.result. The predicate 'the shards decide' (pool=='false' || outcome=='unreachable') is written out separately in unit.if (ci.yml unit job), in the three loop_timing step gates (outcome != 'unreachable') and in check's case. I traced the reachable combinations and found no disagreement. Each predicate is pinned by an exact-string test, and check's verdict step is executed against a 15-row truth table (tests/enforcement/test_ci_unit_shards.py). GitHub's `if:` cannot share a function, so this is recorded, not a defect. Keep the truth-table test as the single place that states the model.", "files": [".github/workflows/ci.yml", "tests/enforcement/test_ci_unit_shards.py"], "fid": "R-5"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "The evals split's key ties to conftest's xdist group with no check, and the documented refresh cannot repair a mismatch (scripts/update-test-durations.sh:99, .test_durations)", "recommendation": "Scope: instance. Every key in .test_durations carries a hardcoded '@packages/evals' suffix, written at update-test-durations.sh:99. That suffix is correct only while conftest.py:134 groups by _package_of(nodeid) and xdist's loadgroup appends '@<group>' to the id before pytest-split reads it. If either changes (a conftest regrouping, or an xdist or pytest-split release), no id matches. pytest-split then quietly balances the evals shards by average duration, and nothing turns red. The slowest shard drifts back toward the 56 minutes this branch fixed. docs/testing.md and the script header say to refresh the file 'when the unit (evals-N) jobs drift apart'. That refresh rewrites the same suffix, so a maintainer who follows the doc changes nothing. tests/test_update_test_durations_script.py:176 only checks that the script writes the suffix; nothing checks it against the conftest. Fix: derive the group in the script from conftest's _package_of rather than a literal. Or add an enforcement test asserting that the committed keys are '<nodeid>@<_package_of(nodeid)>' for collected evals ids, at a floor on the share that match.", "files": ["scripts/update-test-durations.sh", ".test_durations", "tests/test_update_test_durations_script.py"], "fid": "R-6"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "The route probe has no time bound, so a pool that accepts but never answers turns check red instead of falling back (scripts/ci-unit-pool.sh:195)", "recommendation": "Scope: instance. The client download is bounded (curl --max-time 300, ci-unit-pool.sh:123). `testament run --probe --json` at :195 is not. The `route` job's only bound is timeout-minutes: 10 (ci.yml). A coordinator that takes the connection and never replies runs the route job out. check then fails with \"the route job chose no unit route ('')\" (the `*)` arm). The fallback this branch builds is for exactly that half-down pool, and docs/testing.md says 'When the pool is down or lost, CI falls back to the shards'. Instead, every same-repo PR goes red until someone sets TESTAMENT_CI=off, and the message names neither the probe nor the pool. Caveat: whether the testament client bounds its own probe could not be verified from this repo. Fix: wrap the probe in `timeout <N>` and route a timeout to the shards with its own why, as an unreachable answer is. Pin it beside the other probe cases in tests/test_ci_unit_pool_script.py.", "files": ["scripts/ci-unit-pool.sh", ".github/workflows/ci.yml"], "fid": "R-7"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Decisions record (no bound build plan): what this branch decided and what settled each", "recommendation": "Scope: none. No plan claims chore/ci-pool, so there is no ## Goals to judge against. The stated goal (PR #1146): cut CI's unit wall clock, which one evals shard set at about an hour. The decisions, each with a recorded why: (1) evals splits 8 ways with pytest-split duration_based_chunks, not least_duration, so a file's module fixtures are paid once (ci-unit-tests.sh header). (2) A pool route, falling back to the GitHub shards and never to testament's local fallback, which OOMs (docs/testing.md, 'CI on the testament pool'). (3) The client is the console's current wheel, unpinned and sha256-checked as an integrity check, not provenance (script header, docs). Its envelope schema (error.code, error.retryable, report.counts, exit_code) feeds classify() at ci-unit-pool.sh:216-251. A testament release can therefore move the required check's verdict with no 3tears diff. Every path read fails closed (red) or to the shards, so the risk is bounded. (4) --fresh --no-cache on the required run (docs). (5) loop_timing off the pool, run serially in unit-pool (#1140, docs). (6) Two stall bounds widened from 0.5 s to 2 s, assertions unchanged, why in code comments and commit 56dfcf42d and b23064d87. (7) The moved-module guard reads release tag trees, not ancestry, because pool checkouts have no history (test docstring). (8) The artifact upload continues on error (ci.yml comment). One decision is settled only outside the tree: release.yml stays shard-only, and that is stated only in the PR body's 'Not in this PR'. A merge commit does not carry that body into the repo, and release.yml's comment gives no reason. Every capability is reached: update-test-durations.sh by the docs' refresh instruction, --loop-timing by ci.yml's unit-pool.", "fid": "R-8"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Learnings Cross-Check ran over an empty rule set", "recommendation": "Scope: none. `prawduct-hook learnings-files --for-diff` printed no files (exit 0), and /opt/3tears/.claude/wt/ci-pool/.claude/rules/learnings/ does not exist. No core.md and no area file applies, so no finding was escalated against a learning. The binding rules are this repo's CLAUDE.md: lockstep versions, attribution, exceptions, underscores, fakes. None is departed from in the reviewed diff.", "fid": "R-9"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Backlog Reconciliation: no backlog configured for the project; the cache for pacepace/3tears is empty", "recommendation": "Scope: none. There is no .prawduct/project-state.yaml, so backlog_service_repo is unset, and .prawduct/backlog.md does not exist either. `backlog cache-query --repo pacepace/3tears` answered ok (age about 59 min, no sync_error), but with zero open items. `affecting` over the changed files returned nothing. No item can be shown resolved, and C-B1 to C-B3 have nothing to act on. C-B4: the #1140 cited in ci.yml, ci-unit-pool.sh and docs/testing.md resolves false. The store holds no items at all, so that miss cannot tell a dangling id from an untracked repo, and no edit is wanted.", "fid": "R-10"}], "counts": {"blocking": 0, "warning": 3, "note": 7}, "observations": [], "duration_seconds": 720, "scope": null, "scope_chosen_by": "none", "scope_unresolved_cause": "unbound", "scope_reason": "no live plan claims `chore/ci-pool`", "base_extended_from": null, "chunks": [], "chunks_proposed": [], "chunk": null, "base_reviewed": "1cbc805d868b7f6838b952991f0f99d3a02bd516", "record_lint": {"records": ["docs/testing.md"], "chunk_graded": null, "chunks_graded": [], "plan_graded": null, "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": null, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasoned": 0, "learnings-core-raise-unapproved": 0, "learnings-rule-too-long": 0, "learnings-rule-body": 0, "learnings-area-dead": 0, "change-fragment": 0, "retired-claim-survives": 0}}, "dispatched_at": "2026-11-11T21:29:15Z"}}

